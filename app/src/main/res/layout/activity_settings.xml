<?xml version="1.0" encoding="utf-8"?>
<!-- Profile, password, notifications and delete profile (like the website's Settings page) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_screen_header" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page_bg"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="8dp"
                android:text="PREFERENCES" />

            <TextView
                style="@style/SectionTitle"
                android:text="Settings"
                android:textSize="24sp" />

            <!-- Profile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Profile"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/textUsername"
                    style="@style/HintText"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editFirstName"
                    android:text="First name" />

                <EditText
                    android:id="@+id/editFirstName"
                    style="@style/FieldInput"
                    android:autofillHints="personGivenName"
                    android:inputType="textPersonName|textCapWords" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editLastName"
                    android:text="Last name" />

                <EditText
                    android:id="@+id/editLastName"
                    style="@style/FieldInput"
                    android:autofillHints="personFamilyName"
                    android:inputType="textPersonName|textCapWords" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editEmail"
                    android:text="Email" />

                <EditText
                    android:id="@+id/editEmail"
                    style="@style/FieldInput"
                    android:autofillHints="emailAddress"
                    android:inputType="textEmailAddress" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editPhone"
                    android:text="Phone number" />

                <EditText
                    android:id="@+id/editPhone"
                    style="@style/FieldInput"
                    android:autofillHints="phone"
                    android:inputType="phone" />

                <TextView
                    android:id="@+id/textProfileError"
                    style="@style/ErrorText" />

                <Button
                    android:id="@+id/buttonSaveProfile"
                    style="@style/PrimaryButton"
                    android:text="Save profile" />
            </LinearLayout>

            <!-- Password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginBottom="16dp"
                    android:text="Change password"
                    android:textSize="18sp" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editCurrentPassword"
                    android:text="Current password" />

                <EditText
                    android:id="@+id/editCurrentPassword"
                    style="@style/FieldInput"
                    android:autofillHints="password"
                    android:inputType="textPassword" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editNewPassword"
                    android:text="New password" />

                <EditText
                    android:id="@+id/editNewPassword"
                    style="@style/FieldInput"
                    android:autofillHints="newPassword"
                    android:hint="At least 8 characters"
                    android:inputType="textPassword" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editConfirmPassword"
                    android:text="Confirm new password" />

                <EditText
                    android:id="@+id/editConfirmPassword"
                    style="@style/FieldInput"
                    android:autofillHints="newPassword"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/textPasswordError"
                    style="@style/ErrorText" />

                <Button
                    android:id="@+id/buttonChangePassword"
                    style="@style/PrimaryButton"
                    android:text="Change password" />
            </LinearLayout>

            <!-- Notifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transaction alerts"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/HintText"
                        android:layout_marginTop="2dp"
                        android:text="Show a message when a scheduled bill is paid or fails." />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAlerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Transaction alerts" />
            </LinearLayout>

            <!-- Delete profile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Delete profile"
                    android:textSize="18sp" />

                <TextView
                    style="@style/HintText"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="Permanently removes your profile, accounts and history. All accounts must be at $0.00 first."
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/buttonDeleteProfile"
                    style="@style/OutlineButton"
                    android:layout_width="match_parent"
                    android:text="Delete my profile"
                    android:textColor="@color/error_red" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
