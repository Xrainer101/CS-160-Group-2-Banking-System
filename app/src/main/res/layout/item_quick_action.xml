<?xml version="1.0" encoding="utf-8"?>
<!-- One quick-action tile on the home screen (two per row), like .quick-action-card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_quick_action"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="116dp"
    android:orientation="vertical"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/imageActionIcon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/icon_tile_fg" />
    </FrameLayout>

    <TextView
        android:id="@+id/textActionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textActionDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/text_label"
        android:textSize="11sp" />
</LinearLayout>
