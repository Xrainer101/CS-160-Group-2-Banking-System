<?xml version="1.0" encoding="utf-8"?>
<!-- Deposit / Withdraw / Transfer screen. MoveMoneyActivity shows or hides parts for each mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_screen_header" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page_bg"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="8dp"
                android:text="MOVE MONEY" />

            <TextView
                android:id="@+id/textTitle"
                style="@style/SectionTitle"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <!-- Form card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/textFromLabel"
                    style="@style/FieldLabel"
                    android:text="Account" />

                <FrameLayout style="@style/SpinnerBox">

                    <Spinner
                        android:id="@+id/spinnerFrom"
                        android:layout_width="match_parent"
                        android:layout_height="48dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textAvailable"
                    style="@style/HintText"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />

                <!-- Transfer only: where the money goes -->
                <LinearLayout
                    android:id="@+id/groupTransferTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="Send to" />

                    <RadioGroup
                        android:id="@+id/radioSendTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radioMyAccount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="My account"
                            android:textColor="@color/text_dark" />

                        <RadioButton
                            android:id="@+id/radioSomeoneElse"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Another customer"
                            android:textColor="@color/text_dark" />
                    </RadioGroup>

                    <FrameLayout
                        android:id="@+id/frameToAccount"
                        style="@style/SpinnerBox"
                        android:layout_marginBottom="16dp">

                        <Spinner
                            android:id="@+id/spinnerTo"
                            android:layout_width="match_parent"
                            android:layout_height="48dp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/textNoOtherAccounts"
                        style="@style/HintText"
                        android:layout_marginBottom="16dp"
                        android:text="You only have one account. Open another from the home screen, or send to another customer."
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/editRecipient"
                        style="@style/FieldInput"
                        android:layout_marginBottom="6dp"
                        android:hint="Their 10-digit account number"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="10"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textRecipientName"
                        style="@style/HintText"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editAmount"
                    android:text="Amount" />

                <EditText
                    android:id="@+id/editAmount"
                    style="@style/FieldInput"
                    android:hint="$0.00"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editMemo"
                    android:text="Memo (optional)" />

                <EditText
                    android:id="@+id/editMemo"
                    style="@style/FieldInput"
                    android:hint="e.g. Paycheck, Rent share"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="40" />

                <TextView
                    android:id="@+id/textError"
                    style="@style/ErrorText" />

                <Button
                    android:id="@+id/buttonSubmit"
                    style="@style/PrimaryButton" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
