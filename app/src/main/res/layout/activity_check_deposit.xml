<?xml version="1.0" encoding="utf-8"?>
<!-- Deposit a check by photo. CheckDepositActivity reads the amount, check number, routing and
     account numbers with ML Kit text recognition, then the user checks them and deposits. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/view_screen_header" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/page_bg"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="8dp"
                android:text="MOBILE DEPOSIT" />

            <TextView
                style="@style/SectionTitle"
                android:text="Deposit a check"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Take a photo of the front of the check. We'll read the amount and numbers for you to check before depositing."
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <!-- Step 1: photo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="1. Photo of the check"
                    android:textSize="17sp" />

                <TextView
                    style="@style/HintText"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="Lay the check flat on a dark surface in good light, with all four corners showing. Sign the back and write &quot;For mobile deposit only&quot;." />

                <ImageView
                    android:id="@+id/imageCheck"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginBottom="12dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/bg_input"
                    android:contentDescription="Photo of the check"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonTakePhoto"
                        style="@style/OutlineButton"
                        android:layout_width="0dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Take photo" />

                    <Button
                        android:id="@+id/buttonChoosePhoto"
                        style="@style/OutlineButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Choose photo" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textScanStatus"
                    style="@style/HintText"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Step 2: check the details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginBottom="14dp"
                    android:text="2. Check the details"
                    android:textSize="17sp" />

                <TextView
                    style="@style/FieldLabel"
                    android:text="Deposit into" />

                <FrameLayout
                    style="@style/SpinnerBox"
                    android:layout_marginBottom="16dp">

                    <Spinner
                        android:id="@+id/spinnerAccount"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:contentDescription="Account to deposit into" />
                </FrameLayout>

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editAmount"
                    android:text="Amount" />

                <EditText
                    android:id="@+id/editAmount"
                    style="@style/FieldInput"
                    android:hint="$0.00"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editCheckNumber"
                    android:text="Check number" />

                <EditText
                    android:id="@+id/editCheckNumber"
                    style="@style/FieldInput"
                    android:hint="Top right of the check"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="8" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editCheckRouting"
                    android:text="Routing number on the check" />

                <EditText
                    android:id="@+id/editCheckRouting"
                    style="@style/FieldInput"
                    android:hint="9 digits, bottom left"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="9" />

                <TextView
                    style="@style/FieldLabel"
                    android:labelFor="@id/editCheckAccount"
                    android:text="Account number on the check" />

                <EditText
                    android:id="@+id/editCheckAccount"
                    style="@style/FieldInput"
                    android:hint="After the routing number"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="17" />

                <TextView
                    style="@style/HintText"
                    android:layout_marginBottom="14dp"
                    android:text="All three numbers are required. They're printed along the bottom of the check (routing, account, then check number) and stop the same check from being deposited twice. For a Team 2 Bank check (routing 123456789), the account number must be a real Team 2 Bank account, and the money comes out of it." />

                <TextView
                    android:id="@+id/textError"
                    style="@style/ErrorText" />

                <Button
                    android:id="@+id/buttonDeposit"
                    style="@style/PrimaryButton"
                    android:text="Deposit check" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>