<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: grey border, turns blue while you're typing in it -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="2dp" android:color="@color/label_blue" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="1dp" android:color="@color/input_border" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>